            "content": "<?php\nrequire_once 'includes/admin_auth.php';\nrequire_once 'config/database.php';\n\n$adminAuth = new AdminAuth();\n$currentAdmin = $adminAuth->requireAuth();\n\n$database = new Database();\n$db = $database->getConnection();\n\n// Fetch events\n$stmt = $db->prepare(\"SELECT id, event_name, event_description, event_date, event_time, location, is_active, created_at FROM events ORDER BY event_date DESC, event_time DESC, id DESC\");\n$stmt->execute();\n$events = $stmt->fetchAll(PDO::FETCH_ASSOC);\n?>\n\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Events - Admin Panel</title>\n    <link href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css\">\n    <link rel=\"stylesheet\" href=\"assets/css/style.css\">\n</head>\n<body>\n    <?php include 'includes/admin_sidebar.php'; ?>\n\n    <div class=\"admin-content\">\n        <div class=\"admin-header\">\n            <div class=\"header-content\">\n                <h1><i class=\"fas fa-calendar-alt\"></i> Events</h1>\n                <div class=\"header-actions\">\n                    <a href=\"admin_create_event.php\" class=\"btn btn-primary\"><i class=\"fas fa-plus\"></i> Create Event</a>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"admin-main\">\n            <div class=\"list-container\">\n                <div class=\"list-toolbar\">\n                    <div class=\"search-group\">\n                        <i class=\"fas fa-search\"></i>\n                        <input type=\"text\" id=\"searchInput\" placeholder=\"Search events...\">\n                    </div>\n                </div>\n\n                <div class=\"table-wrapper\">\n                    <table class=\"events-table\" id=\"eventsTable\">\n                        <thead>\n                            <tr>\n                                <th>Event</th>\n                                <th>Date</th>\n                                <th>Time</th>\n                                <th>Location</th>\n                                <th>Status</th>\n                                <th>Created</th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            <?php if (empty($events)): ?>\n                                <tr>\n                                    <td colspan=\"6\" style=\"text-align:center;color:#718096;\">No events found</td>\n                                </tr>\n                            <?php else: ?>\n                                <?php foreach ($events as $event): ?>\n                                    <tr>\n                                        <td>\n                                            <div class=\"event-title\"><?php echo htmlspecialchars($event['event_name']); ?></div>\n                                            <?php if (!empty($event['event_description'])): ?>\n                                                <div class=\"event-desc\"><?php echo htmlspecialchars(mb_strimwidth($event['event_description'], 0, 120, '...')); ?></div>\n                                            <?php endif; ?>\n                                        </td>\n                                        <td><?php echo htmlspecialchars(date('M d, Y', strtotime($event['event_date']))); ?></td>\n                                        <td><?php echo htmlspecialchars(substr($event['event_time'], 0, 5)); ?></td>\n                                        <td><?php echo htmlspecialchars($event['location'] ?? '—'); ?></td>\n                                        <td>\n                                            <?php if ((int)$event['is_active'] === 1): ?>\n                                                <span class=\"badge badge-success\">Active</span>\n                                            <?php else: ?>\n                                                <span class=\"badge badge-muted\">Inactive</span>\n                                            <?php endif; ?>\n                                        </td>\n                                        <td><?php echo htmlspecialchars(date('M d, Y', strtotime($event['created_at']))); ?></td>\n                                    </tr>\n                                <?php endforeach; ?>\n                            <?php endif; ?>\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <style>\n    .admin-content { background: #f8f9fa; }\n    .list-container { background: white; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden; }\n    .list-toolbar { display:flex; justify-content: space-between; align-items:center; padding: 16px 20px; border-bottom: 1px solid #f1f3f4; background:#fafbfc; }\n    .search-group { display:flex; align-items:center; gap:10px; border: 2px solid #e2e8f0; border-radius:8px; padding:8px 12px; background:white; }\n    .search-group i { color:#718096; }\n    .search-group input { border:none; outline:none; font-size:14px; width:220px; }\n    .table-wrapper { overflow-x:auto; }\n    table.events-table { width:100%; border-collapse: collapse; }\n    table.events-table th, table.events-table td { padding: 14px 16px; border-bottom: 1px solid #f1f3f4; text-align:left; vertical-align: top; }\n    table.events-table thead th { background:#fafbfc; font-weight:600; color:#2d3748; font-size:13px; text-transform: uppercase; letter-spacing: .3px; }\n    .event-title { font-weight:600; color:#2d3748; }\n    .event-desc { color:#4a5568; font-size: 13px; margin-top:4px; }\n    .badge { display:inline-block; padding:4px 10px; border-radius:999px; font-size:12px; font-weight:600; }\n    .badge-success { background:#d4edda; color:#155724; }\n    .badge-muted { background:#e2e8f0; color:#4a5568; }\n    @media (max-width: 768px) { .search-group input { width: 140px; } }\n    </style>\n\n    <script>\n    // Simple client-side search filter\n    document.getElementById('searchInput').addEventListener('input', function() {\n        const q = this.value.toLowerCase();\n        const rows = document.querySelectorAll('#eventsTable tbody tr');\n        rows.forEach(row => {\n            const text = row.innerText.toLowerCase();\n            row.style.display = text.includes(q) ? '' : 'none';\n        });\n    });\n    </script>\n</body>\n</html>\n\n\n"
