            "content": "<?php\nrequire_once 'includes/auth.php';\n\n$auth = new Auth();\n$message = '';\n$messageType = '';\n\n// Check if admin is already logged in\n$currentAdmin = $auth->getCurrentAdmin();\nif ($currentAdmin) {\n    header('Location: admin_dashboard.php');\n    exit;\n}\n\nif ($_SERVER['REQUEST_METHOD'] === 'POST') {\n    $email = trim($_POST['email']);\n    $password = $_POST['password'];\n    \n    if (empty($email) || empty($password)) {\n        $message = 'Please fill in all fields';\n        $messageType = 'error';\n    } else {\n        $result = $auth->loginAdmin($email, $password);\n        $message = $result['message'];\n        $messageType = $result['success'] ? 'success' : 'error';\n        \n        if ($result['success']) {\n            header('Location: admin_dashboard.php');\n            exit;\n        }\n    }\n}\n\n// Check for registration success message\nif (isset($_GET['registered']) && $_GET['registered'] == '1') {\n    $message = 'Admin registration successful! Please sign in with your credentials.';\n    $messageType = 'success';\n}\n?>\n\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Admin Sign In - Event Attendance</title>\n    <link href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"assets/css/style.css\">\n</head>\n<body>\n    <div class=\"auth-container\">\n        <div class=\"auth-card\">\n            <div class=\"auth-header\">\n                <h1>Admin Portal</h1>\n                <p>Sign in to your admin account to manage the event attendance system</p>\n            </div>\n            \n            <?php if ($message): ?>\n                <div class=\"message <?php echo $messageType; ?>\">\n                    <?php echo htmlspecialchars($message); ?>\n                </div>\n            <?php endif; ?>\n            \n            <form class=\"auth-form\" method=\"POST\" action=\"\">\n                <div class=\"form-group\">\n                    <label for=\"email\">Email Address</label>\n                    <input type=\"email\" id=\"email\" name=\"email\" required \n                           placeholder=\"admin@llcc.edu.ph\"\n                           value=\"<?php echo isset($_POST['email']) ? htmlspecialchars($_POST['email']) : ''; ?>\">\n                </div>\n                \n                <div class=\"form-group\">\n                    <label for=\"password\">Password</label>\n                    <input type=\"password\" id=\"password\" name=\"password\" required>\n                </div>\n                \n                <div class=\"form-options\">\n                    <label class=\"checkbox-container\">\n                        <input type=\"checkbox\" name=\"remember_me\">\n                        <span class=\"checkmark\"></span>\n                        Remember me\n                    </label>\n                    <a href=\"#\" class=\"forgot-password\">Forgot password?</a>\n                </div>\n                \n                <button type=\"submit\" class=\"btn btn-primary\">Sign In</button>\n            </form>\n            \n            <div class=\"auth-footer\">\n                <p>Don't have an admin account? <a href=\"admin_signup.php\">Create one here</a></p>\n                <p><a href=\"signin.php\">Back to Student Login</a></p>\n            </div>\n        </div>\n    </div>\n    \n    <script src=\"assets/js/script.js\"></script>\n</body>\n</html>\n"
